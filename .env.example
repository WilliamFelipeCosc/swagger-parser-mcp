# Copy to `.env` and fill in. Anything already set in the process environment
# (e.g. the `env` map in your MCP client config) takes precedence over this file.

# Required: at least one Swagger/OpenAPI JSON URL
SWAGGER_JSON_V1_URL=https://your-api.example.com/swagger/v1/swagger.json
SWAGGER_JSON_V2_URL=https://your-api.example.com/swagger/v2/swagger.json

# Optional: Azure DevOps integration (Tasks/PBIs, wiki, wiki cache)
AZURE_DEVOPS_ORG_URL=https://dev.azure.com/YOUR_ORG
AZURE_DEVOPS_PAT=your_personal_access_token
AZURE_DEVOPS_PROJECT=YourProjectName

# Optional: wiki cache tuning
# WIKI_CACHE_DB_PATH defaults to the per-user data dir (platformdirs), e.g.
#   Linux:   ~/.local/share/swagger-parser-mcp/wiki_cache.db
#   macOS:   ~/Library/Application Support/swagger-parser-mcp/wiki_cache.db
#   Windows: %LOCALAPPDATA%\swagger-parser-mcp\wiki_cache.db
# An existing <repo>/data/wiki_cache.db is still used if present.
# WIKI_CACHE_DB_PATH=data/wiki_cache.db
# WIKI_CACHE_STALE_SECONDS=86400
