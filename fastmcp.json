{
  "$schema": "https://gofastmcp.com/public/schemas/fastmcp.json/v1.json",
  "source": {
    "type": "filesystem",
    "path": "main.py",
    "entrypoint": "mcp"
  },
  "environment": {
    "type": "uv",
    "python": ">=3.10",
    "editable": ["."]
  },
  "deployment": {
    "transport": "stdio",
    "env_file": ".env",
    "log_level": "INFO"
  }
}
